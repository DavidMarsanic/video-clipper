{
  "version": 1,
  "dependencies": [
    {
      "id": "yt-dlp",
      "name": "yt-dlp",
      "homepage": "https://github.com/yt-dlp/yt-dlp",
      "install": {
        "macos": "brew install yt-dlp"
      }
    },
    {
      "id": "ffmpeg",
      "name": "FFmpeg",
      "homepage": "https://github.com/FFmpeg/FFmpeg",
      "install": {
        "macos": "brew install ffmpeg"
      }
    }
  ],
  "requirements": [
    {
      "id": "chromium-browser",
      "name": "Chrome or Chromium-based browser",
      "homepage": "https://www.google.com/chrome/",
      "note": "Any Chromium-based browser works: Google Chrome, Chromium, Brave, Microsoft Edge, or Arc. Used to render the app's own UI window, same as instaframe.",
      "install": {
        "macos": "brew install --cask google-chrome"
      }
    }
  ]
}
